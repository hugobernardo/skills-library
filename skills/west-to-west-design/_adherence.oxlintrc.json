{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/core/**",
              "components/navigation/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Sora))/i]",
        "message": "Font not provided by the design system. Available: Inter, Sora."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tone|href|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, tone, href, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline)$/]",
        "message": "<Button> variant must be one of 'primary' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Button> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:logo|description|columns|bottomNote|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: logo, description, columns, bottomNote."
      },
      {
        "selector": "JSXOpeningElement[name.name='InvolvedCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|ctaLabel|href|children|key|ref|className|style|children)$/]",
        "message": "<InvolvedCard> doesn't accept that prop. Declared props: title, ctaLabel, href, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:logo|links|ctaLabel|ctaHref|scrolled|key|ref|className|style|children)$/]",
        "message": "<NavBar> doesn't accept that prop. Declared props: logo, links, ctaLabel, ctaHref, scrolled."
      },
      {
        "selector": "JSXOpeningElement[name.name='NewsletterForm'] > JSXAttribute > JSXIdentifier[name!=/^(?:heading|text|onSubmit|key|ref|className|style|children)$/]",
        "message": "<NewsletterForm> doesn't accept that prop. Declared props: heading, text, onSubmit."
      },
      {
        "selector": "JSXOpeningElement[name.name='OfficerCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|company|role|photo|linkedin|key|ref|className|style|children)$/]",
        "message": "<OfficerCard> doesn't accept that prop. Declared props: name, company, role, photo, linkedin."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|subtitle|center|dark|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: eyebrow, title, subtitle, center, dark."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|children|key|ref|className|style|children)$/]",
        "message": "<ServiceCard> doesn't accept that prop. Declared props: icon, title, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SponsorRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:logos|key|ref|className|style|children)$/]",
        "message": "<SponsorRow> doesn't accept that prop. Declared props: logos."
      },
      {
        "selector": "JSXOpeningElement[name.name='TestimonialSlider'] > JSXAttribute > JSXIdentifier[name!=/^(?:quotes|key|ref|className|style|children)$/]",
        "message": "<TestimonialSlider> doesn't accept that prop. Declared props: quotes."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Button": {
        "replaces": []
